# Copy to .env and fill in. SEC requires a descriptive User-Agent with a real
# contact email; requests without one are rejected.
SEC_CONTACT_EMAIL=you@example.com
SEC_USER_AGENT_APP=xbrl-agent-eval

# Local Ollama. Only reachable from the host machine.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
